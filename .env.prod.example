# Production environment. Copy to ~/ai20k-agent/.env.prod on the prod EC2.
APP_ENV=production
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=https://your-production-domain.example

POSTGRES_DB=ai20k_prod
POSTGRES_USER=ai20k_app
POSTGRES_PASSWORD=password
POSTGRES_VOLUME_NAME=ai20k-postgres-prod
DATABASE_URL=postgresql+psycopg://ai20k_app:password@postgres:5432/ai20k_prod
DATABASE_AUTO_CREATE=true

OPENAI_API_KEY=replace-me
LOG_LEVEL=INFO
