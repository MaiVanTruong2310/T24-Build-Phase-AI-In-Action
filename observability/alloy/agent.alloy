logging {
  level  = "info"
  format = "logfmt"
}

// Read Docker JSON logs on the develop/production EC2 and forward them to
// the central Loki instance. The Docker socket is mounted read-only.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(.*)"
    target_label  = "service_name"
    replacement   = "ai20k-$1"
  }

  rule {
    target_label = "environment"
    replacement  = sys.env("OBSERVABILITY_ENVIRONMENT")
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  labels        = {job = "docker"}
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = sys.env("LOKI_URL")
  }
}

// Receive application traces from the backend container and forward them to
// the Tempo OTLP gRPC endpoint on the monitoring EC2.
otelcol.receiver.otlp "backend" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.backend.input]
  }
}

otelcol.processor.batch "backend" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = sys.env("TEMPO_OTLP_ENDPOINT")
    tls {
      insecure = true
    }
  }
}
