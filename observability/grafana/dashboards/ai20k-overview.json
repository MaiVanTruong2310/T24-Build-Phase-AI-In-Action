      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, environment) (rate(http_request_duration_seconds_bucket{job=\"ai20k-backend\",environment=~\"$environment\"}[5m])))", "legendFormat": "p95 {{environment}}", "refId": "A"}],
      "title": "Request latency p95",
