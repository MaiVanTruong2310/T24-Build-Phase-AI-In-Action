      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "100 * (1 - avg by (environment) (rate(node_cpu_seconds_total{job=\"ai20k-node\",mode=\"idle\",environment=~\"$environment\"}[5m])))", "legendFormat": "{{environment}}", "refId": "A"}],
      "title": "Host CPU usage",
