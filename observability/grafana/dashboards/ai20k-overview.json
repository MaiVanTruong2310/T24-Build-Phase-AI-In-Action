      "targets": [{"expr": "node_memory_MemTotal_bytes{job=\"ai20k-node\",environment=~\"$environment\"} - node_memory_MemAvailable_bytes{job=\"ai20k-node\",environment=~\"$environment\"}", "legendFormat": "{{environment}} used", "refId": "A"}],
      "title": "Host memory used",
      "type": "timeseries"
    },
