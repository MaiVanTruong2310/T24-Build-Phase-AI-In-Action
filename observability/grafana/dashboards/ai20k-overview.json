      "targets": [{"expr": "100 * sum by (environment) (rate(http_requests_total{job=\"ai20k-backend\",status=~\"4..\",environment=~\"$environment\"}[5m])) / sum by (environment) (rate(http_requests_total{job=\"ai20k-backend\",environment=~\"$environment\"}[5m]))", "legendFormat": "4xx {{environment}}", "refId": "A"}],
      "title": "4xx error rate",
      "type": "timeseries"
