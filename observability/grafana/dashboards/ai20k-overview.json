      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 34},
      "id": 11,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "100 * sum by (environment) (rate(http_requests_total{job=\"ai20k-backend\",status=~\"5..\",environment=~\"$environment\"}[5m])) / sum by (environment) (rate(http_requests_total{job=\"ai20k-backend\",environment=~\"$environment\"}[5m]))", "legendFormat": "5xx {{environment}}", "refId": "A"}],
      "title": "5xx error rate (%)",
