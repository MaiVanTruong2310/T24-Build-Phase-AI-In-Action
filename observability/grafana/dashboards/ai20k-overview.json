      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "sum by (environment) (rate(node_network_receive_bytes_total{job=\"ai20k-node\",device!~\"lo|docker.*|veth.*\",environment=~\"$environment\"}[5m]))", "legendFormat": "{{environment}} received", "refId": "A"}, {"expr": "sum by (environment) (rate(node_network_transmit_bytes_total{job=\"ai20k-node\",device!~\"lo|docker.*|veth.*\",environment=~\"$environment\"}[5m]))", "legendFormat": "{{environment}} sent", "refId": "B"}],
      "title": "Host network throughput",
