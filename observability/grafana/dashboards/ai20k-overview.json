      "targets": [{"expr": "100 * sum by (environment) (rate(container_cpu_usage_seconds_total{job=\"ai20k-cadvisor\",container_label_com_docker_compose_service=\"backend\",environment=~\"$environment\"}[5m])) / on(environment) count by (environment) (node_cpu_seconds_total{job=\"ai20k-node\",mode=\"idle\",environment=~\"$environment\"})", "legendFormat": "{{environment}} backend", "refId": "A"}],
      "title": "Backend container CPU",
