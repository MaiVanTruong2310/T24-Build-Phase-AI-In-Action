      "targets": [{"expr": "topk(10, sum by (handler, environment) (rate(http_requests_total{job=\"ai20k-backend\",environment=~\"$environment\"}[5m])))", "legendFormat": "{{environment}} {{handler}}", "refId": "A"}],
