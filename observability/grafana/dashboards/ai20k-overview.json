      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "histogram_quantile(0.50, sum by (le, environment) (rate(http_request_duration_seconds_bucket{job=\"ai20k-backend\",environment=~\"$environment\"}[5m])))", "legendFormat": "p50 {{environment}}", "refId": "A"}, {"expr": "histogram_quantile(0.99, sum by (le, environment) (rate(http_request_duration_seconds_bucket{job=\"ai20k-backend\",environment=~\"$environment\"}[5m])))", "legendFormat": "p99 {{environment}}", "refId": "B"}],
