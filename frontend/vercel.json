{
  "regions": [
    "sin1"
  ],
  "rewrites": [
    {
      "source": "/api/:path((?!proxy$).*)",
      "destination": "/api/proxy?__path=:path"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
