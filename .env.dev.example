# Development environment. Copy to ~/ai20k-agent/.env.dev on the dev EC2.
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

POSTGRES_DB=ai20k_dev
POSTGRES_USER=ai20k_app
POSTGRES_PASSWORD=password
POSTGRES_VOLUME_NAME=ai20k-postgres-dev
DATABASE_URL=postgresql+psycopg://ai20k_app:password@postgres:5432/ai20k_dev
DATABASE_AUTO_CREATE=true

OPENAI_API_KEY=replace-me
LOG_LEVEL=INFO
