# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
LLM_REQUEST_TIMEOUT_SECONDS=12
LLM_FAILURE_COOLDOWN_SECONDS=30
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Create missing ORM tables automatically on application startup.
DATABASE_AUTO_CREATE=true
# Set supabase to use native email confirmation; custom keeps legacy auth.
AUTH_PROVIDER=custom
# Private PostgreSQL connection to the Supabase profile database; never expose to frontend.
AUTH_DATABASE_URL=
# Add /login and /forgot-password URLs under Supabase Auth > URL Configuration.
SUPABASE_AUTH_REDIRECT_URL=http://localhost:5173
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=900
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Optional Supabase/PostgREST source used by the medical assistant.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TIMEOUT_SECONDS=8
SUPABASE_CONNECT_TIMEOUT_SECONDS=3
SUPABASE_MAX_CONNECTIONS=50
SUPABASE_MAX_KEEPALIVE_CONNECTIONS=20

# ---- Authentication ----
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Optional deterministic code for local mock OTP testing only.
MOCK_OTP_CODE=

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
