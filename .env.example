# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
LLM_REQUEST_TIMEOUT_SECONDS=12
LLM_FAILURE_COOLDOWN_SECONDS=30
# Race a slow provider with a backup; may incur an extra API call.
LLM_HEDGE_DELAY_SECONDS=3
# Shared deadline for all providers, not a timeout multiplied by backup count.
LLM_TOTAL_TIMEOUT_SECONDS=15
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Create missing ORM tables automatically on application startup.
DATABASE_AUTO_CREATE=true
# Supabase Auth is the only supported identity provider. The legacy value
# "custom" (local password_hash login) was removed and is rejected at startup.
AUTH_PROVIDER=supabase
# Private PostgreSQL connection to the Supabase profile database; never expose to frontend.
AUTH_DATABASE_URL=
# Add /login and /forgot-password URLs under Supabase Auth > URL Configuration.
SUPABASE_AUTH_REDIRECT_URL=http://localhost:5173
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=1
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=900
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Optional Supabase/PostgREST source used by the medical assistant.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TIMEOUT_SECONDS=8
SUPABASE_CONNECT_TIMEOUT_SECONDS=3
SUPABASE_MAX_CONNECTIONS=50
SUPABASE_MAX_KEEPALIVE_CONNECTIONS=20

# ---- Authentication ----
# Session cookies derive their lifetime from JWT_REFRESH_TOKEN_EXPIRE_DAYS and
# must stay aligned with the Supabase Auth refresh-token lifetime.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- Zalo Bot Configuration ----
# Lấy Bot Token từ https://bot.zapps.me (Zalo Bot Creator)
ZALO_BOT_TOKEN=
# Chuỗi secret token tự đặt để xác thực webhook headers X-Bot-Api-Secret-Token
ZALO_BOT_SECRET_TOKEN=
# Chế độ chạy: disabled | polling | webhook
ZALO_BOT_MODE=disabled
# URL public HTTPS của server để nhận Webhook từ Zalo (ví dụ: https://my-domain.com/api/v1/zalo/webhook)
ZALO_WEBHOOK_URL=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Cross-site cookies require HTTPS and exact CORS_ORIGINS entries.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
